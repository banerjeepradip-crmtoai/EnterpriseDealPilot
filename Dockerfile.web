# Hosted ADK dev UI (agents/ orchestrator + specialists) — public demo.
# Separate from the shared mcp-services/* Dockerfile because the command
# differs (uvicorn serving web_app:app, not `cd $MCP_SERVICE_DIR && python
# server.py`), but the same "full repo as build context" reasoning
# applies: see web_app.py's docstring for why.
FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "uvicorn web_app:app --host 0.0.0.0 --port $PORT"]

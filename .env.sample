# Copy to .env for local use and fill in only what you need for the mode
# you're running in. Never commit a real .env file. Values marked "Secret
# Manager" in the architecture doc must never live here past local testing.

# Vertex AI / Gemini Enterprise Agent Platform — the working path. The free
# AI Studio tier's daily quota (20 requests, gemini-3.6-flash) is too tight
# for a multi-agent system; this bills against the project's credits
# instead. Needs `gcloud auth application-default login` run once locally
# and billing active on the project. gemini-3.6-flash 404s under regional
# locations like us-central1 — "global" is what actually has it.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Fallback: a plain AI Studio key. Fine for light testing, hits the daily
# cap fast once agent delegation is involved. Ignored by Gemini chat calls
# once GOOGLE_GENAI_USE_VERTEXAI is set — but NOT ignored by Vertex AI
# Memory Bank (web_app.py), which silently switches to an incompatible
# "Express Mode" if this is set at all, alongside a confusing
# RESOURCE_PROJECT_INVALID error. Leave this blank once GOOGLE_CLOUD_PROJECT
# is set — there's no legitimate reason to have both.
GOOGLE_API_KEY=

# fixture = read samples/salesforce/*.json, no credentials needed (default)
# live    = query a real org via simple_salesforce (see salesforce-metadata/README.md)
SALESFORCE_MODE=fixture

# Auth path 1: an existing access token — short-lived, nothing durable to
# store. Get one with:
#   SF_TEMP_SHOW_SECRETS=true sf org display --target-org enterprisedealpilot --json
SALESFORCE_SESSION_ID=
SALESFORCE_INSTANCE_URL=

# Auth path 2: durable, but the password sits here in plain text.
SALESFORCE_LOGIN_URL=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=test

# Not read by any code yet — documented here so the variable names are
# fixed before Phases 3-5 implement the services that need them.
APPROVAL_TOPIC=
MODEL_ARMOR_TEMPLATE=
ALLOWED_EMAIL_DOMAIN=
